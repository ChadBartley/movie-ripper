# Copy to .env and fill in. .env is gitignored.

# --- User/timezone ---
# Match the host user that owns ./home, ./media, ./logs, ./db
# (`id -u` / `id -g` on the rip machine)
ARM_UID=1000
ARM_GID=1000
TZ=America/Los_Angeles

# --- Optical drives ---
# Comma-separated list. Find with: lsscsi -g
# Each gets passed through to the container.
ARM_DRIVES=/dev/sr0

# --- OMDb ---
# Free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- TMDb ---
# Free key from https://www.themoviedb.org/settings/api
# Used by scripts/identify.sh for series episode mapping.
TMDB_API_KEY=

# --- Polite scraping ---
# Optional. A URL or email the scraped transcript sites can use to reach
# you if your traffic causes a problem. Appended to the User-Agent of
# outbound requests from scripts/fetch_transcripts.py and identify.sh.
# Recommended for any non-trivial use. Examples:
#   SCRAPER_CONTACT=https://github.com/<your-handle>/movie-ripper
#   SCRAPER_CONTACT=mailto:you@example.com
SCRAPER_CONTACT=

# --- SMB / Jellyfin storage ---
# Mounted into the container as /mnt/jellyfin/{movies,series}
SMB_HOST=192.168.1.10
SMB_SHARE=data
SMB_USER=
SMB_PASSWORD=

# Subdirectories under the share root for promote.sh. Adjust to match
# your server layout. Set to empty string to drop titles at the share
# root (e.g. SMB_MOVIES_SUBDIR= if the share IS the movies directory).
SMB_MOVIES_SUBDIR=Movies
SMB_SERIES_SUBDIR=Series
